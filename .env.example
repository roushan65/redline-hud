# Where the dev-server proxy (/lhm/*) forwards to.
LHM_PROXY_TARGET=http://192.168.1.4:8085

# Default endpoint the UI polls (can be changed at runtime in Settings).
# Use "/lhm/data.json" to go through the proxy, or a full URL to hit LHM directly
# (LibreHardwareMonitor sends Access-Control-Allow-Origin: *).
VITE_LHM_URL=http://192.168.1.4:8085/data.json

# live | mock
VITE_DATA_SOURCE=live

# Folder where the dev/preview server saves config.json and the uploaded logo.
PANEL_CONFIG_DIR=./config
